<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="800.0" spacing="10.0"
      style="-fx-background-color: #1e1e2e; -fx-font-family: 'Segoe UI', Helvetica;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.aspecttp.AppController">

    <children>
        <!-- Top Control Bar -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #252538; -fx-background-radius: 8;">
            <children>
                <Label text="Console d'Événements" textFill="#cdd6f4">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <TextField fx:id="searchField" promptText="Filtrer les logs..."
                           style="-fx-background-color: #313244; -fx-text-fill: white; -fx-prompt-text-fill: #a6adc8; -fx-background-radius: 5;"
                           HBox.hgrow="ALWAYS" />

                <Button mnemonicParsing="false" onAction="#handleClearLogs"
                        style="-fx-background-color: #f38ba8; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                        text="Effacer" />
            </children>
            <padding>
                <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
            </padding>
        </HBox>

        <Button mnemonicParsing="false" onAction="#executeRandomOperation"
                style="-fx-background-color: #f38ba8; -fx-text-fill: #11111b; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                text="Éxecuter une opération aléatoire" />

        <!-- Log Data Table -->
        <TableView fx:id="logTable" style="-fx-background-color: #252538; -fx-base: #1e1e2e; -fx-control-inner-background: #252538; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="typeColumn" maxWidth="120.0" minWidth="90.0" prefWidth="100.0" resizable="false" style="-fx-alignment: CENTER;" text="Catégorie" />
                <TableColumn fx:id="timeColumn" maxWidth="160.0" minWidth="130.0" prefWidth="150.0" resizable="false" style="-fx-alignment: CENTER;" text="Horodatage" />
                <TableColumn fx:id="messageColumn" prefWidth="500.0" text="Message de l'événement" style="-fx-alignment: CENTER;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>